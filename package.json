{
  "name": "qarz-daftari",
  "version": "1.0.0",
  "description": "Qarz Daftari — mijozlar qarz/to'lov hisobi (har qanday biznes uchun; kompaniya nomi va logotipi ilova ichida sozlanadi)",
  "main": "main.js",
  "author": "Qarz Daftari",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.qarzdaftari.app",
    "productName": "Qarz Daftari",
    "files": [
      "main.js",
      "index.html",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qarz Daftari"
    }
  }
}
